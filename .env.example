# Database
DATABASE_URL="postgresql://brightloop:brightloop_secret@localhost:5432/brightloop?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_REFRESH_SECRET="change-me-too-another-long-random-string"

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@brightloop.dev"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Brightloop <noreply@brightloop.dev>"

# Email mode: "smtp" | "console" (dev fallback)
EMAIL_MODE="console"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
